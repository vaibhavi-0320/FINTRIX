{
  "name": "fintrix",
  "private": true,
  "version": "0.2.0",
  "description": "Invoice financing marketplace on Stellar with AI document processing",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx backend/dev-server.ts",
    "build": "npm run build --workspace frontend",
    "build:vercel": "tsx scripts/build-vercel.mts",
    "serve": "npm run build && cross-env NODE_ENV=production tsx backend/dev-server.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p frontend/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:testnet": "cross-env FINTRIX_TESTNET=1 vitest run tests/backend/testnet.integration.test.ts",
    "test:e2e": "playwright test",
    "assistant:eval": "cross-env FINTRIX_LIVE_AI=1 vitest run tests/backend/assistant-live.test.ts",
    "test:e2e:testnet": "cross-env E2E_TESTNET=1 playwright test e2e/testnet-journey.spec.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contract:build": "stellar contract build --manifest-path contracts/Cargo.toml",
    "kb:ingest": "tsx scripts/ingest-knowledge.mts",
    "demo:seed": "tsx scripts/seed-demo.mts",
    "fixtures": "tsx scripts/make-fixtures.mts",
    "ml:data": "ml/.venv/Scripts/python ml/generate_dataset.py",
    "ml:train": "ml/.venv/Scripts/python ml/train_risk_model.py",
    "ml:eval-duplicates": "tsx ml/duplicates/evaluate.mts",
    "demo:repay": "tsx scripts/repay-demo.mts"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@huggingface/transformers": "^4.3.2",
    "@stellar/stellar-sdk": "^17.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@vercel/nft": "^1.11.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  }
}
