# Fintrix configuration. Copy to `.env` in the repository root: `cp .env.example .env`
# `.env` is git-ignored. Never commit real keys.
# Variables WITHOUT the VITE_ prefix are server-only.
# VITE_* variables are embedded in the browser bundle, so put only public values there.

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origins allowed to call the API cross-origin (same-origin needs nothing). Comma-separated.
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Reverse proxies in front of the app. Leave unset: 0 locally, 1 automatically on Vercel.
# TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------- database
# Production: Postgres 15+ with the pgvector extension (e.g. Neon, Supabase). SECRET.
# Leave empty locally to use the embedded PGlite database in PGLITE_DIR (no setup needed).
DATABASE_URL=
PGLITE_DIR=.data/pglite
SESSION_TTL_HOURS=168

# ---------------------------------------------------------------- Stellar
# testnet (default) or mainnet. Mainnet is refused unless NODE_ENV=production and STELLAR_RPC_URL is set.
STELLAR_NETWORK=testnet
# Optional overrides (defaults come from the network preset):
# STELLAR_HORIZON_URL=
# STELLAR_RPC_URL=
# Fintrix escrow contract deployed on testnet (see STELLAR_INTEGRATION.md to deploy your own).
FINTRIX_CONTRACT_ID=CBH6Q4U2ESHZOHBS66JSLFRYR6SLFOHO4LKAF2MOHATM3KYIFAJXSSRX
# Settlement token: native XLM Stellar Asset Contract on testnet.
SETTLEMENT_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
SETTLEMENT_ASSET_CODE=XLM
# Fixed conversion used to turn USD invoice values into XLM on testnet (not a market price).
USD_PER_XLM=0.11

# ---------------------------------------------------------------- AI
# Anthropic API key (https://console.anthropic.com/settings/keys). SECRET, server-only.
# Without it: extraction uses local OCR/text rules and the assistant reports that AI is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise local; or force claude / local.
EXTRACTION_PROVIDER=auto
# local = on-device MiniLM model (no key, ~23 MB download); voyage = Voyage AI (use on Vercel); none = keyword search only.
EMBEDDINGS_PROVIDER=local
# Voyage AI key (https://dash.voyageai.com), only if EMBEDDINGS_PROVIDER=voyage. SECRET.
VOYAGE_API_KEY=
# Writable cache for OCR data and models (defaults to .data, or /tmp/fintrix-cache on Vercel).
# FINTRIX_CACHE_DIR=.data
MAX_UPLOAD_BYTES=4194304

# ---------------------------------------------------------------- browser (public)
VITE_STELLAR_NETWORK=testnet
# Only when the API is served from a different origin than the UI:
# VITE_API_URL=
# Never set VITE_E2E_WALLET outside automated tests.
