# Dependencies
node_modules/

# Build output
dist/
frontend/dist/
.vite/
target/
*.tsbuildinfo
.vercel/

# Environment files: secrets never go to git. Only .env.example is committed.
.env
.env.*
!.env.example

# Runtime data written by the Stage 0 file store (user/session data)
data/transactions.json
data/visitors.json

# Stellar CLI local state (identities hold secret keys)
.stellar/
.soroban/

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo

# Design reference sources (large, not part of the app)
stitch_web3_hero_section.zip
frontend/design-references/stitch_web3_hero_section/

# Local embedded database (PGlite) and model caches
.data/

# Soroban test snapshots (regenerated by cargo test)
contracts/test_snapshots/

# Python virtualenvs and generated ML data
ml/.venv/
ml/data/
__pycache__/

# Test and build artefacts
test-results/
playwright-report/
